{
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "pnpm --dir apps/web dev --host 127.0.0.1",
    "dev:api": "cd apps/api && uv run uvicorn holden_reel.main:app --app-dir src --reload --host 127.0.0.1 --port 8000",
    "test": "pnpm typecheck && pnpm test:web && pnpm test:api",
    "test:e2e": "pnpm --dir apps/web test:e2e",
    "typecheck": "pnpm --dir apps/web exec tsc --noEmit",
    "test:web": "pnpm --dir apps/web test --run",
    "test:api": "cd apps/api && uv run pytest -q"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
